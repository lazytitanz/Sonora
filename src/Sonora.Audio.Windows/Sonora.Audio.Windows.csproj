<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Sonora.Audio.Windows</RootNamespace>
    <AssemblyName>Sonora.Audio.Windows</AssemblyName>
    <Description>Windows backend for the Sonora audio engine using NAudio and WASAPI.</Description>
    <PackageId>Sonora.Audio.Windows</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sonora.Audio\Sonora.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Vorbis" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="Concentus" />
    <PackageReference Include="Concentus.Oggfile" />
    <PackageReference Include="ManagedCodecs.Containers" />
    <PackageReference Include="ManagedCodecs.Aac" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sonora.Audio.Windows.Tests" />
    <InternalsVisibleTo Include="Sonora.Benchmarks" />
    <InternalsVisibleTo Include="Sonora.TestPlayer" />
  </ItemGroup>

</Project>
